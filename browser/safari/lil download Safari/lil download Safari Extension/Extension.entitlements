<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Только «почтовый ящик» lil download: класть туда ссылки. Больше ничего
	     в домашней папке расширению не нужно. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/com.lil.download/inbox/</string>
	</array>
</dict>
</plist>
