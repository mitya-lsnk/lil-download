{
  "manifest_version": 3,
  "name": "lil download",
  "description": "Кнопка «Скачать в lil download»: видео со страницы или файл по ссылке",
  "version": "0.1.0",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Скачать в lil download",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "permissions": ["activeTab", "nativeMessaging"]
}
